# Copy to .env (or keep using env.txt). Real environment variables take precedence.

# Server
PORT=3000
HOST=0.0.0.0
# Where the SQLite DB and uploaded files are stored (relative to the folder of this file).
DATA_DIR=data
MAX_UPLOAD_MB=200
# If set, creating a new class (수업) requires this password.
ADMIN_PASSWORD=
# Set to 1 when running behind nginx/Caddy so HTTPS and client IPs are detected.
TRUST_PROXY=0

# How PowerPoint/Word/Excel uploads become 교안 (converted to PDF):
# auto = Microsoft Office if installed (Windows), else LibreOffice; or msoffice, libreoffice, off.
OFFICE_CONVERTER=auto
# Path to LibreOffice's soffice, if it isn't found automatically.
SOFFICE_PATH=

# 화면 공유 (screen sharing). SCREEN_SHARE=off turns it off.
SCREEN_SHARE=
# WebRTC port for students, UDP and TCP (default PORT+1). The 99 UDP ports after it carry the
# screen to relay PCs. firewall.bat opens these; the setup .exe allows StudyShare on any port.
SCREEN_PORT=
# Addresses to offer students, comma-separated, if the automatic list picks a wrong adapter.
SCREEN_IP=
# Students this PC serves before relay PCs get more (a share, not a limit).
SCREEN_DIRECT_SEATS=10
# Password relay PCs connect with. Empty = generated once and kept in DATA_DIR/relay.key.
RELAY_KEY=

# Optional AI helper (AI 도우미 tab). Leave empty to hide the tab.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
