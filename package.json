{
  "name": "remote-study-share",
  "private": true,
  "version": "0.1.0",
  "description": "Realtime lecture-material (교안) sharing: synced PDF viewer, teacher ink, personal notes, Q&A and chat.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning server/index.ts",
    "build": "vite build",
    "start": "tsx --disable-warning=ExperimentalWarning server/index.ts --prod",
    "typecheck": "tsc -p server && tsc -p client"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.53.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
